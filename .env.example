# ============================================================
# Sheep Fight 2 - متغيرات البيئة لخادم الأصدقاء
# انسخ هذا الملف إلى .env واملأ القيم (أو عرّفها مباشرة في النظام)
# ============================================================

# --- Supabase (أنشئ مشروعاً في https://supabase.com) ---
# من Project Settings > API:
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# مفتاح الخدمة السرّي (يُحفظ على الخادم فقط ولا يظهر في المتصفح)
SUPABASE_SERVICE_KEY=eyJ...
# (اختياري) المفتاح العام anon
SUPABASE_ANON_KEY=eyJ...

# --- عنوان خادم المطابقة الذي تملكه (يُعرض في الواجهة فقط) ---
MATCH_SERVER_HOST=common.marketjs-multiplayer.com

# --- منفذ التشغيل ---
PORT=3080

# --- النطاق العام الذي تنشر به الواجهة (اختياري) ---
# PUBLIC_HOST=